server {
    listen 80;
    server_name _;

    root /usr/share/nginx/html;
    index index.html;

    # Uploads maiores (fotos de OS) — igual ao limite da API (20MB)
    client_max_body_size 20m;

    # DNS interno do Docker: resolve o host da API em tempo de execução,
    # evitando crash na subida se o container da API ainda não existir.
    resolver 127.0.0.11 valid=30s ipv6=off;

    # Endereço da API vem da env API_URL (ex.: http://api:5276 no compose,
    # http://mundosmart_api:5276 no Easypanel).
    set $api_upstream ${API_URL};

    # Proxy da API (.NET)
    location /api/ {
        proxy_pass $api_upstream;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # Arquivos servidos pela API (fotos)
    location /uploads/ {
        proxy_pass $api_upstream;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # SPA fallback — rotas do Angular
    location / {
        try_files $uri $uri/ /index.html;
    }
}
